    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "9.33.0",
    "npm-run-all2": "9.0.4",
    "prettier": "3.9.10",
